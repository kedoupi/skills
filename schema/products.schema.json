{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kedoupi/skills/schema/products.schema.json",
  "title": "Kedoupi skill product registry",
  "type": "object",
  "required": ["schema_version", "products"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1"},
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/product"}
    }
  },
  "$defs": {
    "skillName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "repo_dir",
        "repository",
        "type",
        "primary_skill",
        "entrypoints",
        "entrypoint_version_policy",
        "status",
        "purpose",
        "install"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/skillName"},
        "repo_dir": {"type": "string", "pattern": "^[a-z0-9-]+-skill$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[a-z0-9-]+-skill$"},
        "type": {"enum": ["single", "family"]},
        "primary_skill": {"$ref": "#/$defs/skillName"},
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skillName"}
        },
        "entrypoint_version_policy": {"enum": ["lockstep", "independent"]},
        "status": {"enum": ["incubating", "published", "deprecated", "retired"]},
        "purpose": {"type": "string", "minLength": 10},
        "install": {"type": "string", "minLength": 10},
        "catalog_install": {"type": "string", "minLength": 1}
      }
    }
  }
}
