{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kedoupi/skills-incubator/schema/skill-repo.schema.json",
  "title": "Kedoupi Skill Repo (baseline)",
  "description": "Machine-checkable subset of schema/skill-repo.md for a single or family product repo.",
  "type": "object",
  "required": ["name", "repository_type", "primary_skill", "entrypoints", "entrypoint_version_policy", "package"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]{1,2}$",
      "description": "Kebab-case product id; matches the primary skill and <name>-skill repo"
    },
    "repository_type": {
      "enum": ["single", "family"],
      "description": "One primary entrypoint, or a related multi-entrypoint release unit"
    },
    "primary_skill": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]{1,2}$"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]{1,2}$"
      },
      "description": "Every installable skills/<entrypoint>/SKILL.md in the product repo"
    },
    "entrypoint_version_policy": {
      "enum": ["lockstep", "independent"]
    },
    "package": {
      "type": "object",
      "description": "Primary package contract; family facades are enumerated by entrypoints",
      "required": ["skill_md", "scripts"],
      "properties": {
        "skill_md": {
          "type": "object",
          "required": ["name", "description", "version"],
          "properties": {
            "name": { "type": "string" },
            "description": {
              "type": "string",
              "minLength": 20,
              "description": "Must include trigger phrases for auto-invoke"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
            },
            "author": { "type": "string" },
            "requires_bins": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Executable paths relative to skills/<name>/"
        },
        "has_config_example": { "type": "boolean" },
        "has_templates": { "type": "boolean" }
      }
    },
    "repo": {
      "type": "object",
      "properties": {
        "has_readme_en": { "type": "boolean" },
        "has_readme_zh": { "type": "boolean" },
        "has_agents_md": { "type": "boolean" },
        "has_license": { "type": "boolean" },
        "has_tests": { "type": "boolean" },
        "has_ci": { "type": "boolean" }
      }
    },
    "conventions": {
      "type": "object",
      "properties": {
        "durable_config_outside_package": { "const": true },
        "dry_run_offline": { "const": true },
        "pwd_p_path_resolution": { "const": true },
        "no_hardcoded_secrets": { "const": true }
      }
    }
  }
}
