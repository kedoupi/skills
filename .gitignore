# OS / editor
.DS_Store
*.swp
*~
.idea/
.vscode/

# Local backups from register-submodule.sh
.submodule-register-bak-*/

# Secrets / local env (never commit)
**/.skill-data/
**/config.local.env
**/*.pem
.env
.env.*

# Python
__pycache__/
*.pyc

# Vendor skill dirs: we track only skill-incubator symlinks (see scripts/link-agent-skills).
# Ignore any other local vendor clutter under these trees.
.claude/skills/*
!.claude/skills/skill-incubator
.grok/skills/*
!.grok/skills/skill-incubator
