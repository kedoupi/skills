#!/usr/bin/env bash
set -euo pipefail

# Resolve skill root even when reached via agent symlink.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
SKILL_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
SKILL_NAME="$(basename -- "$SKILL_ROOT")"
SKILLS_PARENT="$(dirname -- "$SKILL_ROOT")"

# Recommended brand+XDG config (default for init)
KEDOUPI_CONFIG_DIR="${HOME}/.config/kedoupi/${SKILL_NAME}"
KEDOUPI_CONFIG_FILE="${KEDOUPI_CONFIG_DIR}/config.env"

# Legacy install-adjacent durable (still read; may migrate once)
DURABLE_CONFIG_DIR="${SKILLS_PARENT}/.skill-data/${SKILL_NAME}"
DURABLE_CONFIG_FILE="${DURABLE_CONFIG_DIR}/config.env"

# Shared fallback for copy-mode multi-agent installs.
GLOBAL_SHARED_CONFIG_FILE="${HOME}/.agents/skills/.skill-data/${SKILL_NAME}/config.env"

# Optional in-package override (wiped by npx skills update).
LOCAL_CONFIG_FILE="${SKILL_ROOT}/config.local.env"

# Legacy XDG path.
XDG_CONFIG_FILE="${HOME}/.config/${SKILL_NAME}/config.env"

EXAMPLE_CONFIG_FILE="${SKILL_ROOT}/config.example.env"
SKILL_MD_FILE="${SKILL_ROOT}/SKILL.md"

# Env names use SKILL_* in the template; scripts/new-skill.sh rewrites them
# to <NAME>_CHAT_ID / <NAME>_AS / <NAME>_FOOTER / <NAME>_CONFIG.
ALLOWED_CONFIG_KEYS="SKILL_CHAT_ID SKILL_AS SKILL_FOOTER"

# Snapshot process env so files cannot clobber exported globals (env > files).
_ENV_CHAT_ID="${SKILL_CHAT_ID-}"
_ENV_AS="${SKILL_AS-}"
_ENV_FOOTER="${SKILL_FOOTER-}"
_ENV_HAD_CHAT_ID=0
_ENV_HAD_AS=0
_ENV_HAD_FOOTER=0
[[ -n "${SKILL_CHAT_ID+x}" && -n "${SKILL_CHAT_ID-}" ]] && _ENV_HAD_CHAT_ID=1
[[ -n "${SKILL_AS+x}" && -n "${SKILL_AS-}" ]] && _ENV_HAD_AS=1
[[ -n "${SKILL_FOOTER+x}" && -n "${SKILL_FOOTER-}" ]] && _ENV_HAD_FOOTER=1

# Auto-migrate only from init / doctor (dry-run / which-config stay side-effect free).
ALLOW_CONFIG_MIGRATE="${ALLOW_CONFIG_MIGRATE:-0}"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Require a non-empty option value. Values MAY start with "-" (markdown lists).
require_val() {
  local opt="$1"
  if [[ $# -lt 2 ]]; then
    echo "Missing value for $opt" >&2
    exit 2
  fi
  if [[ -z "$2" ]]; then
    echo "Empty value for $opt" >&2
    exit 2
  fi
}

skill_version() {
  local v=""
  if [[ -f "$SKILL_MD_FILE" ]]; then
    v="$(sed -nE 's/^[[:space:]]*version:[[:space:]]*"([^"]+)".*/\1/p' "$SKILL_MD_FILE" | head -n1)"
  fi
  printf '%s' "${v:-0.0.0}"
}

unquote_config_value() {
  local val="$1"
  if [[ "$val" =~ ^\'(.*)\'$ ]]; then
    val="${BASH_REMATCH[1]}"
  elif [[ "$val" =~ ^\"(.*)\"$ ]]; then
    val="${BASH_REMATCH[1]}"
    val="${val//\\\"/\"}"
  elif [[ "$val" == *\\* ]]; then
    val="${val//\\\'/\'}"
    val="${val//\\\"/\"}"
    val="${val//\\ / }"
    val="${val//\\\\/\\}"
  fi
  printf '%s' "$val"
}

# Safe KEY=VALUE loader: never `source` (avoids shell injection from config files).
load_env_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0

  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ ! "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      continue
    fi
    key="${BASH_REMATCH[1]}"
    val="${BASH_REMATCH[2]}"
    case " ${ALLOWED_CONFIG_KEYS} " in
      *" ${key} "*) ;;
      *) continue ;;
    esac
    val="$(unquote_config_value "$val")"
    if [[ "$val" == *$'\n'* || "$val" == *$'\r'* ]]; then
      echo "Invalid config value (newline) for ${key} in ${file}" >&2
      return 1
    fi
    export "${key}=${val}"
  done <"$file"
}

ensure_kedoupi_config() {
  if [[ "${ALLOW_CONFIG_MIGRATE:-0}" != "1" ]]; then
    return 0
  fi
  if [[ -f "$KEDOUPI_CONFIG_FILE" ]]; then
    return 0
  fi
  local src
  for src in "$DURABLE_CONFIG_FILE" "$GLOBAL_SHARED_CONFIG_FILE" "$XDG_CONFIG_FILE"; do
    if [[ -f "$src" && -s "$src" ]]; then
      mkdir -p "$KEDOUPI_CONFIG_DIR"
      cp "$src" "$KEDOUPI_CONFIG_FILE"
      chmod 600 "$KEDOUPI_CONFIG_FILE" 2>/dev/null || true
      echo "${SKILL_NAME}: migrated config → ${KEDOUPI_CONFIG_FILE}" >&2
      echo "  (from ${src})" >&2
      return 0
    fi
  done
}

load_all_configs() {
  ensure_kedoupi_config
  load_env_file "$XDG_CONFIG_FILE"
  load_env_file "$GLOBAL_SHARED_CONFIG_FILE"
  if [[ "$DURABLE_CONFIG_FILE" != "$GLOBAL_SHARED_CONFIG_FILE" ]]; then
    load_env_file "$DURABLE_CONFIG_FILE"
  fi
  load_env_file "$KEDOUPI_CONFIG_FILE"
  load_env_file "$LOCAL_CONFIG_FILE"
  if [[ -n "${SKILL_ENV_CONFIG:-}" ]]; then
    load_env_file "$SKILL_ENV_CONFIG"
  fi

  if [[ "${_ENV_HAD_CHAT_ID:-0}" -eq 1 ]]; then
    SKILL_CHAT_ID="$_ENV_CHAT_ID"
  fi
  if [[ "${_ENV_HAD_AS:-0}" -eq 1 ]]; then
    SKILL_AS="$_ENV_AS"
  fi
  if [[ "${_ENV_HAD_FOOTER:-0}" -eq 1 ]]; then
    SKILL_FOOTER="$_ENV_FOOTER"
  fi
}

print_config_paths() {
  cat <<EOF
Skill root:           ${SKILL_ROOT}
Version:              $(skill_version)
Kedoupi config:       ${KEDOUPI_CONFIG_FILE}$([[ -f "$KEDOUPI_CONFIG_FILE" ]] && echo "  [exists · recommended]" || echo "  [missing]")
Legacy durable:       ${DURABLE_CONFIG_FILE}$([[ -f "$DURABLE_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Global shared:        ${GLOBAL_SHARED_CONFIG_FILE}$([[ -f "$GLOBAL_SHARED_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Local (in skill):     ${LOCAL_CONFIG_FILE}$([[ -f "$LOCAL_CONFIG_FILE" ]] && echo "  [exists · wiped on skills update]" || echo "  [missing]")
XDG legacy:           ${XDG_CONFIG_FILE}$([[ -f "$XDG_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Explicit override:    ${SKILL_ENV_CONFIG:-"(unset)"}
EOF
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  local chat_id=""
  local as_identity="bot"
  local footer="via ${SKILL_NAME}"
  local force=0
  local target="kedoupi"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --chat-id) require_val "$1" "${2-}"; chat_id="$2"; shift 2 ;;
      --as) require_val "$1" "${2-}"; as_identity="$2"; shift 2 ;;
      --footer) require_val "$1" "${2-}"; footer="$2"; shift 2 ;;
      --target) require_val "$1" "${2-}"; target="$2"; shift 2 ;;
      --force) force=1; shift ;;
      -h|--help)
        cat <<EOF
Usage: ${SKILL_NAME} init [options]

Options:
  --chat-id <id>   Target chat id
  --as <bot|user>  Sending identity (default: bot)
  --footer <text>  Message footer (may start with '-')
  --target <where> kedoupi | durable | global | local (default: kedoupi)
  --force          Overwrite existing config
EOF
        return 0
        ;;
      *) echo "Unknown init option: $1" >&2; return 2 ;;
    esac
  done

  case "$as_identity" in bot|user) ;; *)
    echo "Invalid --as: $as_identity" >&2; return 2 ;;
  esac

  local out_file
  case "$target" in
    kedoupi|default) out_file="$KEDOUPI_CONFIG_FILE" ;;
    durable) out_file="$DURABLE_CONFIG_FILE" ;;
    global) out_file="$GLOBAL_SHARED_CONFIG_FILE" ;;
    local) out_file="$LOCAL_CONFIG_FILE" ;;
    *) echo "Invalid --target: $target" >&2; return 2 ;;
  esac

  if [[ -z "$chat_id" && -t 0 ]]; then
    printf "Chat id: "
    read -r chat_id
  fi
  if [[ -z "$chat_id" ]]; then
    echo "Missing chat id. Pass --chat-id <id>" >&2
    return 2
  fi

  if [[ -f "$out_file" && "$force" -ne 1 ]]; then
    echo "Config already exists: $out_file" >&2
    echo "Re-run with --force to overwrite." >&2
    return 1
  fi

  mkdir -p "$(dirname -- "$out_file")"
  local _v
  for _v in "$chat_id" "$as_identity" "$footer"; do
    if [[ "$_v" == *$'\n'* || "$_v" == *$'\r'* ]]; then
      echo "Config values must not contain newlines" >&2
      return 2
    fi
  done

  # Plain KEY=value (no shell quoting) — pairs with load_env_file allowlist parser.
  cat >"$out_file" <<EOF
# Generated by: ${SKILL_NAME} init
# Skill root: ${SKILL_ROOT}
# Target: ${target}
# Format: KEY=value (never source this file as shell)
SKILL_CHAT_ID=${chat_id}
SKILL_AS=${as_identity}
SKILL_FOOTER=${footer}
EOF
  chmod 600 "$out_file" 2>/dev/null || true
  echo "Wrote ${out_file}"
  if [[ "$target" == "local" ]]; then
    echo "Note: local config is wiped by npx skills update."
  else
    echo "This path survives npx skills update."
  fi
}

# ---------------------------------------------------------------------------
# send (customize this)
# ---------------------------------------------------------------------------

cmd_send() {
  local title="" body="" dry_run=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) require_val "$1" "${2-}"; title="$2"; shift 2 ;;
      --body) require_val "$1" "${2-}"; body="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help)
        cat <<EOF
Usage: ${SKILL_NAME} [options]

Options:
  --title <text>
  --body <text>     May start with '-' (markdown lists OK)
  --dry-run         Local preview only (no side effects)
  --version
EOF
        return 0
        ;;
      --version)
        echo "${SKILL_NAME} v$(skill_version)"
        return 0
        ;;
      *) echo "Unknown option: $1" >&2; return 2 ;;
    esac
  done

  local chat_id="${SKILL_CHAT_ID:-}"
  local as_identity="${SKILL_AS:-bot}"
  local footer="${SKILL_FOOTER:-via ${SKILL_NAME}}"

  if [[ -z "$chat_id" ]]; then
    echo "Missing chat id. Run: bash $0 init --chat-id <id>" >&2
    print_config_paths >&2
    return 2
  fi

  if [[ -z "$title" ]]; then
    title="Notification"
  fi
  if [[ -z "$body" && ! -t 0 ]]; then
    body="$(cat)"
  fi
  if [[ -z "$body" ]]; then
    echo "Message body is empty. Use --body or stdin." >&2
    return 2
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    cat <<EOF >&2
[dry-run] ${SKILL_NAME} v$(skill_version)
[dry-run] chat_id=${chat_id} as=${as_identity}
[dry-run] title=${title}
[dry-run] footer=${footer}
[dry-run] not performing side effects
EOF
    printf '%s\n' "$body"
    return 0
  fi

  # --- replace with actual send logic ---
  echo "[SEND] Replace this with real send command." >&2
  echo "chat_id=${chat_id} title=${title}" >&2
  printf '%s\n' "$body"
  : "${EXAMPLE_CONFIG_FILE}"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

if [[ "${1:-}" == "init" ]]; then
  shift
  ALLOW_CONFIG_MIGRATE=1
  cmd_init "$@"
  exit $?
fi
if [[ "${1:-}" == "config-path" || "${1:-}" == "paths" ]]; then
  print_config_paths
  exit 0
fi
if [[ "${1:-}" == "which-config" ]]; then
  load_all_configs
  print_config_paths
  echo
  echo "Effective:"
  echo "  SKILL_CHAT_ID=${SKILL_CHAT_ID:-"(unset)"}"
  echo "  SKILL_AS=${SKILL_AS:-bot}"
  echo "  SKILL_FOOTER=${SKILL_FOOTER:-via ${SKILL_NAME}}"
  exit 0
fi
if [[ "${1:-}" == "version" || "${1:-}" == "--version" ]]; then
  echo "${SKILL_NAME} v$(skill_version)"
  exit 0
fi

load_all_configs
cmd_send "$@"
