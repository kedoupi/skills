# Copy via:
#   bash scripts/<skill-name> init --chat-id <id>
#
# Recommended durable path (outside skill package, survives skills update):
#   ~/.config/kedoupi/<skill-name>/config.env
# Legacy .skill-data paths may be read for one-shot migration.

# Required
SKILL_CHAT_ID='oc_xxxxxxxx'

# Optional
SKILL_AS='bot'
SKILL_FOOTER='via <skill-name>'
